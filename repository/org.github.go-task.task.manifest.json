{
  "id": "org.github.go-task.task",
  "name": "task",
  "version": "3.39.2",
  "summary": "Task runner and build tool with YAML configuration",
  "description": "Task is a task runner / build tool that aims to be simpler and easier to use than GNU Make, configured using clean YAML files.",
  "license": "MIT",
  "category": "Development",
  "runtime": "org.clipak.Runtime//1.0",
  "binaries": [
    {
      "name": "task",
      "summary": "Task runner and build tool"
    }
  ],
  "curation": {
    "unconfined_reason": "Requires spawning build recipes on host OS",
    "required_host_capabilities": [
      "host-filesystem",
      "host-processes"
    ],
    "flatpak_incompatible": true
  },
  "build": {
    "prefix": "/app",
    "bundle_libraries": [],
    "sources": [],
    "steps": [
      {
        "name": "bundle-task",
        "command": "mkdir -p \"${DESTDIR}/bin\"\ncp -a /usr/bin/task \"${DESTDIR}/bin/task\""
      }
    ],
    "build_env": {}
  }
}