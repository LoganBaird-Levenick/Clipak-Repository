{
  "id": "org.restic.restic",
  "name": "restic",
  "version": "0.17.1",
  "summary": "Secure, deduplicated, encrypted backup program",
  "description": "restic is a secure backup program that uses cryptography to guarantee confidentiality and integrity of your backup data.",
  "license": "BSD-2-Clause",
  "category": "Utilities",
  "runtime": "org.clipak.Runtime//1.0",
  "binaries": [
    {
      "name": "restic",
      "summary": "Encrypted backup program"
    }
  ],
  "curation": {
    "unconfined_reason": "Requires reading entire host filesystem trees (/home, /var, /etc) for snapshots",
    "required_host_capabilities": [
      "host-filesystem"
    ],
    "flatpak_incompatible": true
  },
  "build": {
    "prefix": "/app",
    "bundle_libraries": [],
    "sources": [],
    "steps": [
      {
        "name": "bundle-restic",
        "command": "mkdir -p \"${DESTDIR}/bin\"\ncp -a /usr/bin/restic \"${DESTDIR}/bin/restic\""
      }
    ],
    "build_env": {}
  }
}